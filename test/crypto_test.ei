import { assert } from "std.core"
import { Crypto } from ".crypto.crypto"
import { Encoding } from ".crypto.encoding"
import { CryptoException } from ".crypto.crypto"

// SHA-256 of "abc" (FIPS 180-4 test vector)
test "crypto: sha256Hex known vector" {
    assert(Crypto.sha256Hex("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
}

// RFC 4231 Test Case 2: HMAC-SHA256 with key "Jefe",
// data "what do ya want for nothing?"
test "crypto: hmacSha256Hex RFC 4231 vector" {
    assert(Crypto.hmacSha256Hex("what do ya want for nothing?", "Jefe") == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
}

// RFC 7636 Appendix B: S256 code challenge for the well-known verifier
test "crypto: sha256Base64Url PKCE RFC 7636 vector" {
    val verifier = "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
    assert(Crypto.sha256Base64Url(verifier) == "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM")
}

test "crypto: secureRandom length and uniqueness" {
    val a = Crypto.secureRandom(43)
    val b = Crypto.secureRandom(43)
    assert(a.length == 43)
    assert(b.length == 43)
    assert(a != b)
}

test "crypto: base64url round-trip without padding" {
    val enc = Encoding.base64UrlNoPadding("hello eiwa")
    assert(enc == "aGVsbG8gZWl3YQ")
    assert(Encoding.base64UrlDecode(enc) == "hello eiwa")
}

test "crypto: base64url round-trip with padding" {
    val enc = Encoding.base64Url("hi")
    assert(enc == "aGk=")
    assert(Encoding.base64UrlDecode(enc) == "hi")
}

test "crypto: base64url decode accepts padded and unpadded" {
    assert(Encoding.base64UrlDecode("aGk=") == "hi")
    assert(Encoding.base64UrlDecode("aGk") == "hi")
}

// ES256: sign with a generated P-256 key, then verify structure (b64url of 64 raw bytes)
// Key generated with: openssl ecparam -genkey -name prime256v1
test "crypto: signEcdsaP256 produces JWS raw signature" {
    val pem = "-----BEGIN EC PRIVATE KEY-----\nMHcCAQEEILcHcqL/KEoVGlPkvVJqPEH350q9QgnY/a8KBSke+axloAoGCCqGSM49\nAwEHoUQDQgAE1fQo2UYHn6sGQZ4SsPUJC4wbkBa25be3NGE/4GWlr9RMQp6JrpUc\nLJ3+eIjzsnUjIysWokyY2sdxfyKgzCIetw==\n-----END EC PRIVATE KEY-----\n"
    val sig = Crypto.signEcdsaP256("test.header.payload", pem)
    // raw r||s = 64 bytes -> base64url no padding = ceil(64/3)*4 - padding = 86 chars
    assert(sig.length == 86)
    // deterministic shape: only base64url alphabet
    var i = 0
    while (i < sig.length) {
        val c = sig.substring(i, i + 1)
        assert("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_".indexOf(c) >= 0)
        i = i + 1
    }
}

// RFC 6455 Section 1.3: accept for the well-known example key.
test "crypto: sha1Base64 RFC 6455 accept vector" {
    val key = "dGhlIHNhbXBsZSBub25jZQ=="
    val accept = Crypto.sha1Base64("${key}258EAFA5-E914-47DA-95CA-C5AB0DC85B11")
    assert(accept == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")
}

test "crypto: base64 standard vectors" {
    assert(Encoding.base64("hello eiwa") == "aGVsbG8gZWl3YQ==")
    assert(Encoding.base64("hi") == "aGk=")
    assert(Encoding.base64("abc") == "YWJj")
}

test "crypto: randomBase64 shape for a 16-byte key" {
    val k = Crypto.randomBase64(16)
    assert(k.length == 24)
    val k2 = Crypto.randomBase64(16)
    assert(k != k2)
}

test "crypto: signEcdsaP256 rejects garbage key with exception (not SIGSEGV)" {
    var threw = false
    try {
        Crypto.signEcdsaP256("header.payload", "not-a-key")
    } catch (e: CryptoException) {
        threw = true
    }
    assert(threw)
}

test "crypto: base64UrlDecode rejects invalid input with exception" {
    var threw = false
    try {
        Encoding.base64UrlDecode("!!!not-b64!!!")
    } catch (e: CryptoException) {
        threw = true
    }
    assert(threw)
}

test "crypto: sha256HexBytes matches sha256Hex on ASCII" {
    assert(Crypto.sha256HexBytes("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
}

test "crypto: hmacSha256HexBytes matches hmacSha256Hex on ASCII" {
    assert(Crypto.hmacSha256HexBytes("what do ya want for nothing?", "Jefe") == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
}

test "crypto: sha256HexBytes is NUL-safe (does not truncate at 0x00)" {
    // bytes [0x61, 0x00, 0x62] = "a\0b" — strlen-based hash would hash only "a"
    val buf = Standard.gcMalloc(4)
    NativeMemory.writeByte(buf, 0, 97)
    NativeMemory.writeByte(buf, 1, 0)
    NativeMemory.writeByte(buf, 2, 98)
    NativeMemory.writeByte(buf, 3, 0)
    val bin = String(buf, 3)
    assert(bin.length == 3)
    val full = Crypto.sha256HexBytes(bin)
    val trunc = Crypto.sha256Hex("a")
    assert(full != trunc)
    // python: hashlib.sha256(b"a\x00b").hexdigest()
    assert(full == "59b271ae1bbcb1d31d41929817f4b16fb439eb4f31520b5ad1d5ce98920a7138")
}

test "crypto: hmacSha256Raw chaining matches SigV4 key derivation" {
    // AWS SigV4 example: key derivation must use raw 32-byte intermediates,
    // not hex strings. Chained raw HMACs must verify against openssl:
    // echo -n "20120215" | openssl dgst -sha256 -mac HMAC -macopt hexkey:<kSecret...>
    val kSecret = "AWS4wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY"
    val kDate = Crypto.hmacSha256Raw("20120215", kSecret)
    assert(kDate.length == 32)
    val kRegion = Crypto.hmacSha256Raw("us-east-1", kDate)
    assert(kRegion.length == 32)
    val kService = Crypto.hmacSha256Raw("iam", kRegion)
    val kSigning = Crypto.hmacSha256Raw("aws4_request", kService)
    val sig = Crypto.hmacSha256HexBytes("test-string-to-sign", kSigning)
    assert(sig.length == 64)
    // hex-chained (wrong) derivation must differ — guards against
    // accidentally passing hex strings as the next key.
    val wrongDate = Crypto.hmacSha256HexBytes("20120215", kSecret)
    assert(wrongDate.length == 64)
    assert(wrongDate != kDate)
}
