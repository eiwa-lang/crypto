import { String } from "std.core"
import { NativeCrypto } from ".crypto.native"

// Cryptographic primitives backed by OpenSSL (libcrypto).
// Mirrors kargo-crypto's API surface used by underhold services.
object Crypto {

    // SHA-256 of a UTF-8 string, hex-encoded (lowercase).
    fun sha256Hex(data: String): String {
        return String(NativeCrypto.sha256Hex(data.ptr))
    }

    // SHA-256 of a UTF-8 string, base64url-encoded without padding.
    // This is the PKCE S256 code_challenge form (RFC 7636).
    fun sha256Base64Url(data: String): String {
        return String(NativeCrypto.sha256Base64Url(data.ptr))
    }

    // HMAC-SHA256 hex digest. Used by the signed session cookie transport.
    fun hmacSha256Hex(data: String, secret: String): String {
        return String(NativeCrypto.hmacSha256Hex(data.ptr, secret.ptr))
    }

    // Cryptographically secure random string: base64url(no padding) of `n`
    // random bytes, truncated to `n` chars. Used for PKCE verifier/state/nonce.
    fun secureRandom(length: Int): String {
        return String(NativeCrypto.randomBase64Url(length), length)
    }

    // SHA-1 digest, standard base64 (RFC 4648 §4, with padding).
    // Used for the WebSocket accept key (RFC 6455 §4.2.2).
    fun sha1Base64(data: String): String {
        return String(NativeCrypto.sha1Base64(data.ptr))
    }

    // Cryptographically secure random string: standard base64 (with
    // padding) of `n` random bytes. `randomBase64(16)` is the
    // Sec-WebSocket-Key form (RFC 6455 §4.1).
    fun randomBase64(n: Int): String {
        return String(NativeCrypto.randomBase64(n))
    }

    // Signs data with an EC P-256 private key (PEM) and returns the JWS/ES256
    // signature: base64url(no padding) of raw r||s (64 bytes) — NOT the
    // ASN.1/DER form.
    fun signEcdsaP256(data: String, privateKeyPem: String): String {
        val pem = privateKeyPem.replace("\\n", "\n")
        return String(NativeCrypto.signEs256(data.ptr, pem.ptr))
    }
}
